module.extend('assistance_forgot', function(self, settings, shared) {
	
	
	self.proto({
		 
		initialize : function(params)
		{
			 
			
	  },
	  
	  init_fb : function()
	  {
	  	this.get('login_fb').$.bind('click', jyingo.delegate(this, this.login_fb));
	  },
	  
	  login_fb : function()
	  {
      FB.login(jyingo.delegate(this, this.login_response));
	  },
	  
	  login_response : function(response)
	  {
	  	 if (response && response.authResponse && response.authResponse.accessToken)
	  	  this.call(function(){}, 'login_ok', response.authResponse.accessToken);
	  }
	  
	});
	
	$this = new self();
	return $this;
	
});module.extend('countdown', function(self, settings, shared) {
	
	var seconds = 0, int = 0;
	
	function tick()
	{
		
		seconds--;
		set_text();
		
		
	}
	
	function set_text()
	{
		
		 var secs = seconds % 60;		 
		 var mins = Math.floor(seconds/60)%60;
		 var hrs = Math.floor(seconds / 3600);
		 
		 if (secs < 10) secs = '0' + secs;
		 if (mins < 10) mins = '0' + mins;
		 if (hrs < 10) hrs = '0' + hrs;
		 
		$this.get('countdown').set_text(hrs+':'+mins+':'+secs);
		  
		
	}
	
	self.proto({
		 
		initialize : function(params)
		{
			
		 seconds = params.seconds;
		 int = setInterval(tick, 1000);
		 set_text();
		  	 
			
	  },
	  

	  
	});
	
	$this = new self();
	return $this;
	
});var facebook = null;
module.extend('facebook', function(self, settings, shared) {
	
	var _tid;
	
	self.prototype = {
		
		
		initialize : function(params)
		{
	
		   facebook = this;
		   
		   FB.init({
		      appId      : params.fbappid,
		      status     : true,
		      xfbml      : true,
		      hideFlashCallback : this.create_delegate(this.onFlashHide)
		   });
		},
		
		onFlashHide : function(info)
		{
			if(info.state == 'opened') {
   		  this.message('toggle_flash', false);
  		} else {
   		  this.message('toggle_flash', true);
  		}

		},
		
		login_result : function(params)
		{ 
			if (params && params.status == 'connected')
			{
				cb({ accessToken : params.authResponse.accessToken, user: {} });
			} else {
				cb(null);
			}
		},
		
		beginPurchaseOf : function(product_id)
		{
			this.call(this.purchase_response, 'begin_purchase_of', product_id);
		},
		
		purchase_response : function(response)
		{
			_tid = response._tid;
			
			FB.ui({
	      method: 'pay',
	      action: 'purchaseitem',
	      product: response._url,
	      request_id: response._tid
	    	},
	    
   			this.create_delegate(this.facebook_purchase_response)
		
			);
		},
		
		facebook_purchase_response : function(response)
		{
		 if (response.error_code || !response.payment_id)
		 {
		 	 
		 	 cb2({ call : 'beginPurchaseOf', success : false });
		 	
		 } else {
		  
		  	setTimeout(this.create_delegate(this.facebook_purchase_verify), 1000);
		  
		 	
		 }
		},
		
		facebook_purchase_verify : function()
		{
			 this.call(this.facebook_purchase_verify_response, 'verify_payment', _tid);
			
		},
		
		facebook_purchase_verify_response : function(response)
		{
			
			if (response.retry)
			{
				 
		  	setTimeout(this.create_delegate(this.facebook_purchase_verify), 1000);
		  	return;
		  	
			}
			
			var result = { call : 'beginPurchaseOf', success : response.success, data : response};
			cb2(result);
			
		},
		
		requestProductsInfo : function(products)
		{
			
			this.call(this.products_info_received, 'request_products_info', products);
			
		},
		
		products_info_received : function(result)
		{
			
			 var obj = { call : 'requestProductsInfo', list : result };
			 cb2(obj);
			
		},
		
		request_dialog_response : function(response)
		{
			
			var result = null;
			if (response && response.request)
			{
				var list = response.to;
				result = { request : response.request, list : list };
			}
			
			cb(result);
		},
		
		requestFriendDialog : function(request)
		{
			
			  request.requestData.method = 'apprequests';
			  FB.ui(request.requestData, this.create_delegate(this.request_dialog_response));

			
		},
		
		login : function(permissions)
		{
			
			var _delegate = this.create_delegate(this.login_result);
	    var _permissions = permissions;
			 
		  FB.getLoginStatus(function(response) {
		  	
				if (response.status == 'connected' && response.authResponse)
				{
				 _delegate(response);
				}
				else
				{
			   FB.login( _delegate, { scope: permissions });  	
				}
				
			});
			
		}
		
 };
 
 return new self();
	
});module.aliver= function(params)
{
	 
};


module.aliver.prototype = {
	
	initialize : function() {
		 this.timer = setInterval(this.create_delegate(this.ping), 30000);
	},
	
	ping : function()
	{
		this.call(function(){},'ping');
	},
	
	dispose : function()
	{
		clearInterval(this.timer);
	}
	
};module.extend('assistance_stolen', function(self, settings, shared) {
	
	
	self.proto({
		 
		initialize : function(params)
		{
			 
			
	  },
	  
	  init_fb : function()
	  {
	  	this.get('login_fb').$.bind('click', jyingo.delegate(this, this.login_fb));
	  },
	  
	  login_fb : function()
