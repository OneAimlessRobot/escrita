      FB.login(jyingo.delegate(this, this.login_response));
	  },
	  
	  login_response : function(response)
	  {
	  	 if (response && response.authResponse && response.authResponse.accessToken)
	  	  this.call(function(){}, 'login_ok', response.authResponse.accessToken);
	  }
	  
