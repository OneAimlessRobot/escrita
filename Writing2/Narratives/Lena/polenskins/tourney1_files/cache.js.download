	return $this;
	
});page.extend('assistance', function(self, settings, shared) {
	
	
	self.proto({
		 
		initialize : function(params)
		{
			 
			
	  },
	  
	  init_captcha : function(container, parameters)
	  { 
	  	grecaptcha.ready(function() {
	  	  if (container)
	  	  {
		 		 	grecaptcha.render(container, parameters);
	  	  } else {
	  	  	grecaptcha.reset();
	  	  }
	  	});
	  	
	  }
	  
	});
	
	$this = new self();
	return $this;
	
});
function cb(obj) {
	return document.getElementById('ForestKeeper_Web').__facebookMgrCallback(obj);
}
function cb2(obj) {
	return document.getElementById('ForestKeeper_Web').__storeMgrCallback(obj);
}
var main;
page.game = function(params)
{
	main = this;
};

page.game.prototype = {
	
	
	
	initialize : function(params)
	{
		  
		  this._use_flash_obscuration = false;
			this._force_show_interval = 0;
			

	     this.game_params = params;
			 this.listen('toggle_flash');
			 this.listen('use_flash_obscuration');
	     if (cached_fb_page_infos)
	     {
	      	setTimeout(this.create_delegate(this.check_height), 100);
	      	
	     } else {
	     	
	     	 this.initialize_flash($(window).height());
	     	
	     }
	
	
    
  },
  
  fallback : function()
  {
  	
  	location.href='/?fallback=true';
  	
  },
  
  check_height : function()
  {
  	 
  	 if (!canvh())
  	 {
  	 	
	      	setTimeout(this.create_delegate(this.check_height), 100);
	      	return;
  	 }
  	 
  	 this.initialize_flash(canvh());
  },
  
  initialize_flash : function(h)
  {
       if (h < 650) h = 650;
       
  
  
       var _flashVersion = (swfobject.getFlashPlayerVersion().major);
       if (_flashVersion < 15)
       {
       	 if (window.chrome)
       	 {
       	   location.href='manteinance/upgrade_chrome.html?'+Math.random();	
       	 } else {
       	   location.href='manteinance/upgrade_generic.html?'+Math.random();	
       	 } 
       } 
  
       this.swf_width = $(window).width();
       this.swf_height = h;
	 		 var swf = this.game_params.game.replace('random', Math.random());
       var swfVersionStr = "15.0.0";
       var xiSwfUrlStr = "playerProductInstall.swf";
       var flashvars = { https : window.location.protocol == 'https:', windowWidth : this.swf_width, windowHeight : this.swf_height };
       var params = {};
       
       params.quality = "high";
       params.wmode = "direct";
       params.bgcolor = "#ffffff";
       params.allowscriptaccess = "always";
       params.allownetworking = "all";
       params.allowfullscreen = "true";
      
       var attributes = {};
       attributes.id = "ForestKeeper_Web";
       attributes.name = "ForestKeeper_Web";
       attributes.align = "middle";
       
       
       swfobject.embedSWF(
             "/package/" + swf, "flashContent", 
             $(window).width(), h,  
             swfVersionStr, xiSwfUrlStr, 
             flashvars, params, attributes);
                
       swfobject.createCSS("#flashContent", "display:block;");
       
  },
  
  screenshot : function(data)
  {
  	
  	   	 $('#closeWnd').css({ width : this.swf_width, height : this.swf_height, 'background-size' : this.swf_width+'px ' + this.swf_height+'px', 'background-image' : 'url(data:image/jpeg;base64,' + data +')', display : 'block' });
  },
  
  received_message : function(sender, message, data)
  {
  	
  	 if (message == 'use_flash_obscuration')
  	 {
  	   this._use_flash_obscuration  = true;	
  	 }
  	
  	 if (message == 'toggle_flash')
  	 {
  	  
  	   if (data == true)
  	   {
  	   	
	  	   	if (this._force_show_interval)
	  	   	{
	  	   		clearInterval(this._force_show_interval);
	  	   		this._force_show_interval = 0;
	  	   	}
	  	   	
  	   	if (this._use_flash_obscuration == true)
  	   	{
  	   		 this._use_flash_obscuration = false;
  	   		 $('#closeWnd').css({ 'background-image' : '', display : 'none' });
  	   		
  	   	} else {



  	   	}

  	   	
  			var el = document.getElementById('ForestKeeper_Web');
  			el.focus();  	   	
  	   	
  	   //	 $('#closeWnd').css({ 'background-image' : '', display : 'none' });
  	   	
  	   } else {
  	   	
  	   		if (this._use_flash_obscuration == true)
  	   		{
  	   			
  	   	 var data = document.getElementById('ForestKeeper_Web').exportScreenshot();
  	   	 $('#closeWnd').css({ 'background-image' : '', display : 'block' });
  	   	
  	   		} else {
  	   		
  	   		
  	    	if (this._force_show_interval == 0)
  	    		this._force_show_interval = setInterval(this.create_delegate(this._check_flash_visibility), 100);
  	    			
  	   		}
  	    	
  	    	
  	    	
  	    	
  	    	
  	   }
  	 	
  	 } 
  	
  },
  
  _check_flash_visibility : function()
  {
  	
  	var el = document.getElementById('ForestKeeper_Web');
  	
  	var cur = $(el).css('visibility');
  	if (cur == 'hidden')
  	{
  		$(el).css('visibility', 'visible');
  		el.focus();
  	}
  }
  
};page.login = function(params)
{
	
};

page.login.prototype = {
	
	initialize : function(params)
	{
		
		setTimeout(this.create_delegate(this.login), 300);
		
	},
	
	login : function()
	{
		
		 var _delegate = this.create_delegate(this.login_result);
		 FB.getLoginStatus(function(response) {
		  	
				if (response.status == 'connected' && response.authResponse)
				{
				  location.href='/index.php?register=true';
				}
				else
				{
			   FB.login( _delegate, { scope: 'publish_actions,user_location,user_birthday,email' });  	
				}
				
			});
		
	},
	
	login_result : function(response)
	{
		if (response && response.status == 'connected')
		{
	  
	   
		 location.href='/index.php?register=true';
	  
	  } else {
	    this.login();	
	  } 	
	}
	
	
};